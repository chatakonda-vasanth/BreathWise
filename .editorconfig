# Editor defaults for this repository. Prettier is authoritative for code
# layout; this file keeps editors from fighting it (and covers the file types
# Prettier does not format, such as .env.example and Dockerfiles).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
