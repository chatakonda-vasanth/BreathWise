{
  "name": "cleanair-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "audit": "npm audit --audit-level=low",
    "secrets": "gitleaks git --no-banner --redact -v",
    "smoke": "bash scripts/smoke.sh",
    "check:bundles": "node scripts/check-client-bundles.mjs",
    "check:secrets-in-bundle": "node scripts/check-secrets-in-bundle.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react": "^7.37.5",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "4.148.0"
  }
}
