{
  "name": "urban-air-quality-assistant",
  "version": "1.0.0",
  "description": "Urban Air Quality Assistant — GenAI guidance for smog days: low-emission daily routines, indoor air quality hacks and sustainable alternatives tailored to your location and lifestyle, with the direct impact of each choice explained.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "audit": "npm audit --audit-level=low",
    "secrets": "gitleaks git --no-banner --redact -v",
    "smoke": "bash scripts/smoke.sh",
    "check:bundles": "node scripts/check-client-bundles.mjs",
    "check:secrets-in-bundle": "node scripts/check-secrets-in-bundle.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:circular": "npx --yes madge@8.0.0 --circular --extensions ts,tsx src",
    "check:knip": "knip --no-progress",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:security": "vitest run tests/security",
    "secrets:dir": "gitleaks dir . --no-banner --redact",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:bundles && npm run check:secrets-in-bundle && npm run check:knip"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.2.1",
    "@upstash/redis": "1.41.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@opennextjs/cloudflare": "1.20.12",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-react": "7.37.5",
    "knip": "6.49.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "sharp": "0.35.5",
    "undici": "7.30.2"
  }
}
