# ---------------------------------------------------------------------------
# CleanAir Companion — environment variables (copy to .env.local for local dev)
# NEVER commit real values. .env* is gitignored.
# ---------------------------------------------------------------------------

# --- LLM (server-side only; never exposed to the browser) -------------------
# Google AI Studio API key. Used only by /api/plan on the server.
GEMINI_API_KEY=
# Model id, no "models/" prefix. Configurable so the deployment can move models
# without a code change. Default when unset: gemini-3.5-flash
# (gemini-2.5-flash is retired for newly created API keys, so do not set it.)
GEMINI_MODEL=gemini-3.5-flash
# Kill switch: "true" disables all LLM calls and serves the deterministic plan.
LLM_DISABLED=false
# Daily cap on LLM generations (counter kept in Upstash, not in a database).
DAILY_LLM_CAP=200
# Optional: lower the per-attempt AI timeout in ms. Clamped to 18000, so it can
# only be tightened, never raised past the function's own budget. Unset = 18000.
# LLM_ATTEMPT_TIMEOUT_MS=18000

# --- Rate limiting (Upstash Redis, free tier) -------------------------------
# REQUIRED in production. Without both, every route fails closed: /api/plan
# returns the labelled rule-based plan (HTTP 200, no model call) and
# /api/air, /api/geocode return 503. Development uses a per-instance in-memory
# limiter and prints one startup warning. Never leave production unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional ---------------------------------------------------------------
# Public origin used for same-origin checks in production (e.g. https://cleanair.example).
# When unset, the request Host header is used.
APP_ORIGIN=
